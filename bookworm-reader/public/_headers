# Cloudflare Pages reads this file from the site root (it is ignored by other hosts).
# Security headers that a <meta> tag cannot set. The page-level Content-Security-Policy
# is injected into index.html at build time (build/csp.js); this adds the part that only
# works as a real HTTP header.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'none'

# Built files have content hashes in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
