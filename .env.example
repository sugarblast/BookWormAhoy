# Copy to .env.local for local development (this file is git-ignored).
#
# OAuth client IDs for web apps are public identifiers, not secrets, so it is
# safe for this value to end up in the built JavaScript. Never put a client
# SECRET anywhere in this project; the sign-in flow used here does not need one.
#
# For GitHub Pages, set the same value as a repository *variable* named
# GOOGLE_CLIENT_ID (Settings > Secrets and variables > Actions > Variables).
VITE_GOOGLE_CLIENT_ID=
