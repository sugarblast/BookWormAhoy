# Copy to .env.local for local development (this file is git-ignored).
#
# Both values are public identifiers, not secrets, so it is safe for them to end
# up in the built JavaScript. The API key is restricted to your site's address in
# Google Cloud Console (see the README). Never put a client SECRET anywhere in
# this project; the sign-in flow used here does not need one.
#
# For GitHub Pages, set the same values as repository *variables* named
# GOOGLE_CLIENT_ID, GOOGLE_API_KEY and (optionally) DROPBOX_APP_KEY (Settings > Secrets and variables > Actions > Variables).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Optional: Dropbox app key (Dropbox App Console). Leave empty to hide the Dropbox source.
VITE_DROPBOX_APP_KEY=
